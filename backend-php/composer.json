{
  "name": "sicta/backend-php",
  "description": "Backend PHP pour l'espace PRO SICTA",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "firebase/php-jwt": "^6.9",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.5",
    "respect/validation": "^2.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "start": "php -S localhost:3001 -t api",
    "test": "phpunit --configuration phpunit.xml"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
